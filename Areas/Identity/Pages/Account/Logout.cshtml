@page
@model LogoutModel
@{
    ViewData["Title"] = "Cerrar sesión";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="card-header">
            <div class="auth-icon"><i class="bi bi-box-arrow-right"></i></div>
            <div>Cerrar sesión</div>
        </div>
        <div class="card-body">
            @{
                if (User.Identity?.IsAuthenticated ?? false)
                {
                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                        <button type="submit" class="nav-link btn btn-link text-dark">Haz clic aquí para cerrar sesión</button>
                    </form>
                }
                else
                {
                    <p class="mb-0">Has cerrado sesión correctamente en la aplicación.</p>
                }
            }
        </div>
    </div>
</div>
