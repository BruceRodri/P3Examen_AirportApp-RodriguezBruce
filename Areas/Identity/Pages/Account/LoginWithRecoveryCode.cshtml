@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Verificación con código de recuperación";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="card-header">
            <div class="auth-icon"><i class="bi bi-key-fill"></i></div>
            <div>Verificación con código de recuperación</div>
        </div>
        <div class="card-body">
            <p class="text-muted">
                Has solicitado iniciar sesión con un código de recuperación. Este inicio de sesión no se recordará hasta que proporciones
                un código de la aplicación de autenticación al iniciar sesión o desactives la 2FA e inicies sesión nuevamente.
            </p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Código de recuperación" />
                    <label asp-for="Input.RecoveryCode" class="form-label">Código de recuperación</label>
                    <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Iniciar sesión</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
