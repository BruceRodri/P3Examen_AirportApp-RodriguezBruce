@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="card-header">
            <div class="auth-icon">&#128273;</div>
            <div>¿Olvidaste tu contraseña?</div>
        </div>
        <div class="card-body">
            <p class="text-muted">Ingresa tu correo electrónico.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="correo@ejemplo.com" />
                    <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Restablecer contraseña</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
