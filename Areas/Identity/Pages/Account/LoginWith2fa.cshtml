@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Autenticación de dos factores";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="card-header">
            <div class="auth-icon">&#128274;</div>
            <div>Autenticación de dos factores</div>
        </div>
        <div class="card-body">
            <p class="text-muted">Tu inicio de sesión está protegido con una aplicación de autenticación. Ingresa tu código de autenticación a continuación.</p>
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <input asp-for="RememberMe" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" />
                    <label asp-for="Input.TwoFactorCode" class="form-label">Código de autenticación</label>
                    <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMachine" class="form-label">
                        <input asp-for="Input.RememberMachine" />
                        Recordar esta máquina
                    </label>
                </div>
                <div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Iniciar sesión</button>
                </div>
            </form>
            <hr class="my-4" />
            <p class="mb-0 text-center">
                ¿No tienes acceso a tu dispositivo de autenticación? Puedes
                <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">iniciar sesión con un código de recuperación</a>.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
