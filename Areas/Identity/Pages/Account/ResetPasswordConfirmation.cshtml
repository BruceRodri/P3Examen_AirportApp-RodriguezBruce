@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Confirmación de restablecimiento de contraseña";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="card-header">
            <div class="auth-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div>Confirmación de restablecimiento de contraseña</div>
        </div>
        <div class="card-body">
            <p class="mb-0">
                Tu contraseña ha sido restablecida. <a asp-page="./Login">Haz clic aquí para iniciar sesión</a>.
            </p>
        </div>
    </div>
</div>
