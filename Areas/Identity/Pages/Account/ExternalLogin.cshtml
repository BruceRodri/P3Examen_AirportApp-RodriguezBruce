@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Registrarse";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="card-header">
            <div class="auth-icon"><i class="bi bi-person-plus-fill"></i></div>
            <div>Registrarse</div>
        </div>
        <div class="card-body">
            <h2 id="external-login-title" class="h5 text-navy">Asociar tu cuenta de @Model.ProviderDisplayName</h2>
            <p id="external-login-description" class="text-muted">
                Te autenticaste correctamente con <strong>@Model.ProviderDisplayName</strong>.
                Ingresa una dirección de correo electrónico para este sitio a continuación y haz clic en el botón
                Registrarse para finalizar el inicio de sesión.
            </p>
            <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="correo@ejemplo.com" />
                    <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Registrarse</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
