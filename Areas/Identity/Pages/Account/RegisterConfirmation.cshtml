@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de registro";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="card-header">
            <div class="auth-icon">&#9989;</div>
            <div>Confirmación de registro</div>
        </div>
        <div class="card-body">
            @{
                if (@Model.DisplayConfirmAccountLink)
                {
            <p>
                Esta aplicación no tiene actualmente un remitente de correo real configurado; consulta <a href="https://aka.ms/aspaccountconf">estos documentos</a> para saber cómo configurar un remitente de correo real.
                Normalmente esto se enviaría por correo electrónico: <a id="confirm-link" href="@Model.EmailConfirmationUrl">Haz clic aquí para confirmar tu cuenta</a>
            </p>
                }
                else
                {
            <p class="mb-0">
                Revisa tu correo electrónico para confirmar tu cuenta.
            </p>
                }
            }
        </div>
    </div>
</div>
