@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="hero mb-4">
    <h1 class="fw-bold">Error</h1>
    <p class="lead mb-0">Ocurrió un error al procesar su solicitud.</p>
</div>

@if (Model.ShowRequestId)
{
    <div class="card">
        <div class="card-body">
            <p><strong>ID de solicitud:</strong> <code>@Model.RequestId</code></p>
        </div>
    </div>
}
