@model P3Examen_AirportApp.Models.Airport

@{
    ViewData["Title"] = "Crear";
}

<h1>Crear</h1>

<h4>Aeropuerto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Iata" class="control-label"></label>
                <input asp-for="Iata" class="form-control" />
                <span asp-validation-for="Iata" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Icao" class="control-label"></label>
                <input asp-for="Icao" class="form-control" />
                <span asp-validation-for="Icao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
