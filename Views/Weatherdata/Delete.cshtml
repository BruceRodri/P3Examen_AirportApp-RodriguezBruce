@model P3Examen_AirportApp.Models.Weatherdatum

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar</h1>

<h3>¿Está seguro de que desea eliminar este registro?</h3>
<div>
    <h4>Dato meteorológico</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Temp)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Temp)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Humidity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Humidity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Airpressure)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Airpressure)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Wind)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Wind)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Winddirection)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Winddirection)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Weather)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Weather)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="LogDate" />
        <input type="hidden" asp-for="Time" />
        <input type="hidden" asp-for="Station" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver a la lista</a>
    </form>
</div>
