@model IEnumerable<P3Examen_AirportApp.Models.Weatherdatum>

@{
    ViewData["Title"] = "Datos meteorológicos";
    string searchString = (string)ViewData["SearchString"] ?? "";
    string searchDate = (string)ViewData["SearchDate"];
    string sortOrder = (string)ViewData["SortOrder"] ?? "";
    int currentPage = (int)ViewData["CurrentPage"];
    int totalPages = (int)ViewData["TotalPages"];
    int totalRecords = (int)ViewData["TotalRecords"];
    int pageSize = (int)ViewData["PageSize"];
}

<h1>Datos meteorológicos</h1>

<form method="get" asp-action="Index" class="row g-3 mb-3">
    <div class="col-md-3">
        <input type="text" name="searchString" value="@searchString" class="form-control" placeholder="Buscar por estación..." />
    </div>
    <div class="col-md-3">
        <input type="date" name="searchDate" value="@searchDate" class="form-control" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
</form>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table table-app">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@(sortOrder == "date_desc" ? "" : "date_desc")"
                   asp-route-searchString="@searchString"
                   asp-route-searchDate="@searchDate">@Html.DisplayNameFor(model => model.LogDate)</a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Time)
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sortOrder="@(sortOrder == "station" ? "station_desc" : "station")"
                   asp-route-searchString="@searchString"
                   asp-route-searchDate="@searchDate">@Html.DisplayNameFor(model => model.Station)</a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Temp)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Humidity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Airpressure)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Wind)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Winddirection)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Weather)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LogDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Time)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Station)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Temp)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Humidity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Airpressure)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Wind)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Winddirection)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Weather)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-logDate="@item.LogDate" asp-route-time="@item.Time" asp-route-station="@item.Station">Editar</a> <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-logDate="@item.LogDate" asp-route-time="@item.Time" asp-route-station="@item.Station">Detalles</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-logDate="@item.LogDate" asp-route-time="@item.Time" asp-route-station="@item.Station">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>

<p>
    Pagina @currentPage de @totalPages - @totalRecords registros - Tamano de pagina: @pageSize
</p>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(currentPage - 1)"
                   asp-route-searchString="@searchString"
                   asp-route-searchDate="@searchDate"
                   asp-route-sortOrder="@sortOrder">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Pagina @currentPage de @totalPages</span></li>
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(currentPage + 1)"
                   asp-route-searchString="@searchString"
                   asp-route-searchDate="@searchDate"
                   asp-route-sortOrder="@sortOrder">Siguiente</a>
            </li>
        </ul>
    </nav>
}
