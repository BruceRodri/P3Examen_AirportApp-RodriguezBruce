@model P3Examen_AirportApp.Models.Flight

@{
    ViewData["Title"] = "Detalles";
}

<h1>Detalles</h1>

<div>
    <h4>Vuelo</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Departure)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Departure)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Arrival)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Arrival)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Airline)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Airline.AirlineId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Airplane)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Airplane.AirplaneId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FlightnoNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FlightnoNavigation.Flightno)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FromNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FromNavigation.AirportId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ToNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ToNavigation.AirportId)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.FlightId">Editar</a> |
    <a asp-action="Index">Volver a la lista</a>
</div>
