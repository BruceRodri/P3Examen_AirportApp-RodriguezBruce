@model IEnumerable<P3Examen_AirportApp.Models.Passenger>

@{
    ViewData["Title"] = "Pasajeros";
}

<h1>Pasajeros</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table table-app">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Passportno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Firstname)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lastname)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Passportno)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Firstname)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Lastname)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.PassengerId">Editar</a> <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.PassengerId">Detalles</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.PassengerId">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
