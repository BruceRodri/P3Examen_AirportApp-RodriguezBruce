@model IEnumerable<P3Examen_AirportApp.Models.Passengerdetail>

@{
    ViewData["Title"] = "Detalles de pasajeros";
}

<h1>Detalles de pasajeros</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table table-app">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Birthdate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sex)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Street)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Zip)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Emailaddress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telephoneno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Passenger)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Birthdate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sex)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Street)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.City)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Zip)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Country)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Emailaddress)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telephoneno)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Passenger.PassengerId)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.PassengerId">Editar</a> <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.PassengerId">Detalles</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.PassengerId">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
