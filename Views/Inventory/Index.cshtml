@model IEnumerable<P3Examen_AirportApp.Models.Commerce.AirportService>

@{
    ViewData["Title"] = "Inventario";
}

<div class="hero mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1 class="fw-bold">Inventario de servicios</h1>
        <p class="lead mb-0">Administra el stock y los precios de los servicios aeroportuarios.</p>
    </div>
    <a class="btn btn-warm btn-lg" asp-action="Inicializar">Inicializar inventario</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-app mb-0">
            <thead>
                <tr>
                    <th>Servicio</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Agregar stock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td><span class="badge-status @(item.Stock > 0 ? "bg-approved" : "bg-canceled")">@item.Stock</span></td>
                        <td>
                            <form asp-action="AumentarStock" method="post" class="d-flex gap-2">
                                <input type="hidden" name="id" value="@item.AirportServiceId" />
                                <input type="number" name="cantidad" value="1" min="1" class="form-control" style="width:90px" />
                                <button class="btn btn-success">Aumentar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
