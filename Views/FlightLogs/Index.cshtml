@model IEnumerable<P3Examen_AirportApp.Models.FlightLog>

@{
    ViewData["Title"] = "Bitácoras de vuelo";
}

<h1>Bitácoras de vuelo</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table table-app">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LogDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FlightnoOld)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FlightnoNew)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FromOld)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ToOld)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FromNew)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ToNew)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DepartureOld)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ArrivalOld)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DepartureNew)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ArrivalNew)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AirplaneIdOld)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AirplaneIdNew)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AirlineIdOld)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AirlineIdNew)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Flight)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LogDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FlightnoOld)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FlightnoNew)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FromOld)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ToOld)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FromNew)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ToNew)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DepartureOld)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ArrivalOld)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DepartureNew)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ArrivalNew)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AirplaneIdOld)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AirplaneIdNew)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AirlineIdOld)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AirlineIdNew)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Comment)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Flight.FlightId)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.FlightLogId">Editar</a> <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.FlightLogId">Detalles</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.FlightLogId">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
