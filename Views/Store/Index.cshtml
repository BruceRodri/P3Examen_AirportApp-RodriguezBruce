@model IEnumerable<P3Examen_AirportApp.Models.Commerce.AirportService>

<h1>Catálogo de servicios aeroportuarios</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Servicio</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Comprar</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.UnitPrice.ToString("C")</td>
            <td>@item.Stock</td>
            <td>
                <form asp-action="AddToCart" method="post" class="d-flex gap-2">
                    <input type="hidden" name="airportServiceId" value="@item.AirportServiceId" />
                    <input type="number" name="quantity" value="1" min="1" max="@item.Stock" class="form-control" style="width:90px" />
                    <button class="btn btn-primary">Agregar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<a class="btn btn-success" asp-action="Cart">Ver carrito</a>
