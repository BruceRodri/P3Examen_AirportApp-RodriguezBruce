@model IEnumerable<P3Examen_AirportApp.Models.Commerce.AirportService>

@{
    ViewData["Title"] = "Servicios";
    var iconos = new[] { "bi-palette", "bi-car-front-fill", "bi-bus-front-fill", "bi-star-fill", "bi-person-badge-fill", "bi-cone-striped" };
    var i = 0;
}

<div class="hero mb-4">
    <h1 class="fw-bold">Servicios aeroportuarios</h1>
    <p class="lead mb-0">Elige un servicio, selecciona aeropuerto, fecha y horario, y reserva tu cupo con pago en línea.</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card card-hover h-100">
                <div class="card-body d-flex flex-column">
                    <div class="feature-icon mb-3"><i class="bi @iconos[i % iconos.Length]"></i></div>
                    <h5 class="card-title text-navy">@item.Name</h5>
                    <p class="text-muted mb-1">Precio por servicio: <strong class="text-navy">@item.UnitPrice.ToString("C")</strong></p>
                    <p class="text-muted small">Stock disponible: @item.Stock</p>
                    <div class="mt-auto pt-2">
                        <a class="btn btn-primary w-100" asp-action="Reserve" asp-route-id="@item.AirportServiceId">Reservar</a>
                    </div>
                </div>
            </div>
        </div>
        i++;
    }
</div>
