@model IEnumerable<P3Examen_AirportApp.Models.Commerce.AirportService>

<h1>Catálogo de servicios aeroportuarios</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Servicio</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Reservar</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.UnitPrice.ToString("C")</td>
            <td>@item.Stock</td>
            <td>
                <a class="btn btn-primary" asp-action="Reserve" asp-route-id="@item.AirportServiceId">Reservar</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<a class="btn btn-success" asp-action="Cart">Ver carrito</a>
