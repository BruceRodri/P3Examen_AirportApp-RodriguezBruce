@model P3Examen_AirportApp.ViewModels.ReserveViewModel

@{
    ViewData["Title"] = "Reservar servicio";
    var airports = ViewData["Airports"] as SelectList;
    var selectedAirportText = Model.SelectedAirportId.HasValue
        ? airports?.FirstOrDefault(a => a.Value == Model.SelectedAirportId.Value.ToString())?.Text
        : null;
}

<div class="hero mb-4">
    <h1 class="fw-bold">Reservar: @Model.ServiceName</h1>
    <p class="lead mb-0">Precio unitario: <strong class="hero-accent">@Model.UnitPrice.ToString("C")</strong></p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header">1. Elige aeropuerto y fecha</div>
    <div class="card-body">
        <form asp-action="@(Model.SlotsShown ? "ConfirmReservation" : "CheckAvailability")" method="post">
            <input type="hidden" name="AirportServiceId" value="@Model.AirportServiceId" />

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Aeropuerto</label>
                    <select asp-for="AirportId" asp-items="airports" class="form-select" required>
                        <option value="">-- Seleccione un aeropuerto --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha</label>
                    <input type="date" name="ServiceDate" value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" class="form-control" required min="@DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cantidad</label>
                    <input type="number" name="Quantity" value="@Model.Quantity" min="1" max="10" class="form-control" required />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn @(Model.SlotsShown ? "btn-outline-secondary" : "btn-primary") w-100">
                        @(Model.SlotsShown ? "Volver a comprobar" : "Comprobar disponibilidad")
                    </button>
                </div>
            </div>

            @if (Model.SlotsShown)
            {
                <h5 class="text-navy mt-4 mb-3">2. Horarios disponibles para @selectedAirportText el @Model.SelectedDate?.ToString("dd/MM/yyyy")</h5>

                if (Model.AvailableTimes.Count == 0)
                {
                    <div class="alert alert-warning">No hay cupos disponibles para ese aeropuerto y fecha. Pruebe otra fecha.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        @foreach (var time in Model.AvailableTimes)
                        {
                            <label class="form-check form-check-inline slot-option">
                                <input class="form-check-input" type="radio" name="StartTime" value="@time.ToString("HH:mm")" required />
                                <span class="slot-chip">@time.ToString("HH:mm")</span>
                            </label>
                        }
                    </div>

                    <button class="btn btn-success btn-lg">Confirmar reserva</button>
                }
            }
        </form>
    </div>
</div>

<a class="btn btn-link mt-3" asp-action="Index">&larr; Volver al catálogo</a>
