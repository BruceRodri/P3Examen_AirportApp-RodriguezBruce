@{
    ViewData["Title"] = "Panel del Administrador";
}
<h1>Panel del Administrador</h1>
<p>Esta página solo puede ser vista por usuarios con rol Administrador.</p>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Órdenes</h5>
                <p class="card-text">Consultar todas las órdenes de los clientes.</p>
                <a asp-controller="Payment" asp-action="AdminOrders" class="btn btn-primary">Ver órdenes</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Pagos y transacciones</h5>
                <p class="card-text">Revisar todos los pagos y transacciones registradas.</p>
                <a asp-controller="Payment" asp-action="AdminTransactions" class="btn btn-primary">Ver pagos</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Reporte general</h5>
                <p class="card-text">Reportes de ingresos, estados y servicios más vendidos.</p>
                <a asp-controller="Payment" asp-action="AdminReport" class="btn btn-primary">Ver reporte</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Inventario de servicios</h5>
                <p class="card-text">Administrar stock de los servicios aeroportuarios.</p>
                <a asp-controller="Inventory" asp-action="Index" class="btn btn-secondary">Administrar inventario</a>
            </div>
        </div>
    </div>
</div>
