@model IEnumerable<P3Examen_AirportApp.Models.AirplaneType>

@{
    ViewData["Title"] = "Tipos de avión";
}

<h1>Tipos de avión</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table table-app">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Identifier)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Identifier)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.TypeId">Editar</a> <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.TypeId">Detalles</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.TypeId">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
