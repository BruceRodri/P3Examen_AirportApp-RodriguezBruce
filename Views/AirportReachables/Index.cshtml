@model IEnumerable<P3Examen_AirportApp.Models.AirportReachable>

@{
    ViewData["Title"] = "Alcance de aeropuertos";
}

<h1>Alcance de aeropuertos</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table table-app">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Hops)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Airport)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Hops)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Airport.AirportId)
            </td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.AirportId">Editar</a> <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@item.AirportId">Detalles</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.AirportId">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
