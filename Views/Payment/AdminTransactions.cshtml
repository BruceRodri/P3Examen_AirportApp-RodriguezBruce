@model IEnumerable<P3Examen_AirportApp.Models.Commerce.PaymentTransaction>

@{
    ViewData["Title"] = "Pagos y transacciones - Administración";
}

<div class="hero mb-4">
    <h1 class="fw-bold">Pagos y transacciones</h1>
    <p class="lead mb-0">Todos los pagos registrados por PayPhone y PayPal.</p>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-app mb-0">
            <thead>
                <tr>
                    <th>Transacción</th>
                    <th>Orden</th>
                    <th>Proveedor</th>
                    <th>Estado</th>
                    <th>Monto</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model)
                {
                    <tr>
                        <td>@payment.PaymentTransactionId</td>
                        <td>#@payment.PurchaseOrderId</td>
                        <td>@payment.Provider</td>
                        <td>@await Html.PartialAsync("_EstadoBadge", payment.Status)</td>
                        <td><strong>@((payment.AmountInCents / 100m).ToString("C"))</strong></td>
                        <td>@payment.PurchaseOrder.UserEmail</td>
                        <td>@payment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-controller="Payment" asp-route-id="@payment.PaymentTransactionId">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-primary" asp-action="AdminReport" asp-controller="Payment">Ver reporte general</a>
    <a class="btn btn-outline-primary" asp-action="AdminOrders" asp-controller="Payment">Ver órdenes</a>
</div>
