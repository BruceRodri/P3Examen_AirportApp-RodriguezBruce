@model P3Examen_AirportApp.Models.Commerce.PaymentTransaction

@{
    ViewData["Title"] = "Comprobante de pago";
}

<h1>Comprobante de pago</h1>

<div class="card mb-3">
    <div class="card-header">Orden #@Model.PurchaseOrderId</div>
    <div class="card-body">
        <p><strong>Cliente:</strong> @Model.PurchaseOrder.UserEmail</p>
        <p><strong>Fecha de creación:</strong> @Model.PurchaseOrder.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
        <p><strong>Estado de la orden:</strong> @Model.PurchaseOrder.Status</p>
        <p><strong>Pasarela:</strong> @Model.Provider</p>
        <p><strong>Estado del pago:</strong> @Model.Status</p>
        <p><strong>Transacción cliente:</strong> @Model.ClientTransactionId</p>
        <p><strong>Moneda:</strong> @Model.Currency</p>
        @if (!string.IsNullOrWhiteSpace(Model.PayPalCaptureId))
        {
            <p><strong>Captura PayPal:</strong> @Model.PayPalCaptureId</p>
        }
        @if (Model.ConfirmedAt.HasValue)
        {
            <p><strong>Confirmado en:</strong> @Model.ConfirmedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
        }
    </div>
</div>

@if (Model.PurchaseOrder.Details.Any())
{
    <h3>Detalle de la orden</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Servicio</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.PurchaseOrder.Details)
            {
                <tr>
                    <td>@detail.ServiceName</td>
                    <td>@detail.Quantity</td>
                    <td>@detail.UnitPrice.ToString("C")</td>
                    <td>@detail.Subtotal.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th>@Model.PurchaseOrder.Total.ToString("C")</th>
            </tr>
        </tfoot>
    </table>
}

@{
    var reservations = ViewData["Reservations"] as List<P3Examen_AirportApp.Models.Commerce.ServiceReservation>;
}

@if (reservations != null && reservations.Count > 0)
{
    <h3>Reservas</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Servicio</th>
                <th>Aeropuerto</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Cantidad</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reserva in reservations)
            {
                <tr>
                    <td>@reserva.AirportService?.Name</td>
                    <td>@reserva.AirportName</td>
                    <td>@reserva.ServiceDate.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.StartTime.ToString("HH:mm")</td>
                    <td>@reserva.Quantity</td>
                    <td>@reserva.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.Provider == "PayPhone" && !string.IsNullOrWhiteSpace(Model.PayphonePaymentUrl) && Model.Status == "Pending")
{
    <a class="btn btn-success" href="@Model.PayphonePaymentUrl" target="_blank">
        Abrir link de pago PayPhone
    </a>
}

@if (Model.Provider == "PayPal" && Model.Status == "Pending" && !string.IsNullOrWhiteSpace(Model.PayPalApprovalUrl))
{
    <a class="btn btn-info" href="@Model.PayPalApprovalUrl" target="_blank">
        Abrir PayPal Sandbox
    </a>
}

@if (Model.Status == "Approved")
{
    <div class="alert alert-success mt-3">
        Pago aprobado correctamente.
    </div>
}

@if (User.IsInRole("Administrador") && Model.Status == "Pending")
{
    <a class="btn btn-warning" asp-action="MarkAsPaid" asp-route-id="@Model.PaymentTransactionId">
        Marcar como pagado para demostración
    </a>
}
