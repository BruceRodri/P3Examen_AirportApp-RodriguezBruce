@model P3Examen_AirportApp.Models.Commerce.PurchaseOrder
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    var paypalClientId = Configuration["PayPal:ClientId"];
}

<div class="hero mb-4">
    <h1 class="fw-bold">Pago con PayPal Sandbox</h1>
    <p class="lead mb-0">Completa el pago de tu reserva con el botón oficial de PayPal.</p>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <p><span class="text-muted">Orden:</span> <strong>#@Model.PurchaseOrderId</strong></p>
                <p><span class="text-muted">Total:</span> <span class="fs-4 fw-bold text-navy">@Model.Total.ToString("C")</span></p>
                <p><span class="text-muted">Estado:</span> @await Html.PartialAsync("_EstadoBadge", Model.Status)</p>
                <div class="alert alert-info">
                    Puedes probar con cuenta Sandbox o con tarjeta de prueba.
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <div id="paypal-button-container"></div>
                <div id="paypal-message" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=@paypalClientId&currency=USD&components=buttons&enable-funding=card"></script>

    <script>
        let paymentTransactionId = 0;

        function showMessage(message, type) {
            document.getElementById('paypal-message').innerHTML =
                '<div class="alert alert-' + type + '">' + message + '</div>';
        }

        paypal.Buttons({
            createOrder: function () {
                return fetch('/Payment/CreatePayPalButtonOrderJson?orderId=@Model.PurchaseOrderId', {
                    method: 'POST'
                })
                .then(response => response.json())
                .then(data => {
                    if (!data.success) {
                        showMessage(data.message, 'danger');
                        throw new Error(data.message);
                    }

                    paymentTransactionId = data.paymentTransactionId;
                    return data.paypalOrderId;
                });
            },

            onApprove: function (data) {
                return fetch('/Payment/CapturePayPalButtonOrderJson', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        paypalOrderId: data.orderID,
                        paymentTransactionId: paymentTransactionId
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = data.redirectUrl;
                    } else {
                        showMessage(data.message, 'danger');
                    }
                });
            },

            onCancel: function () {
                showMessage('Pago cancelado por el usuario.', 'warning');
            },

            onError: function (err) {
                console.error(err);
                showMessage('Ocurrió un error con PayPal Sandbox.', 'danger');
            }
        }).render('#paypal-button-container');
    </script>
}
