@model P3Examen_AirportApp.Models.Airline

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar</h1>

<h3>¿Está seguro de que desea eliminar este registro?</h3>
<div>
    <h4>Aerolínea</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Iata)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Iata)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Airlinename)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Airlinename)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BaseAirport)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BaseAirport)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="AirlineId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver a la lista</a>
    </form>
</div>
