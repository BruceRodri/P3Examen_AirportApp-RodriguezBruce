@model P3Examen_AirportApp.Models.Airline

@{
    ViewData["Title"] = "Editar";
}

<h1>Editar</h1>

<h4>Aerolínea</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AirlineId" />
            <div class="form-group">
                <label asp-for="Iata" class="control-label"></label>
                <input asp-for="Iata" class="form-control" />
                <span asp-validation-for="Iata" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Airlinename" class="control-label"></label>
                <input asp-for="Airlinename" class="form-control" />
                <span asp-validation-for="Airlinename" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BaseAirport" class="control-label"></label>
                <input asp-for="BaseAirport" class="form-control" />
                <span asp-validation-for="BaseAirport" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver a la lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
